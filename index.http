@baseUrl = http://localhost:4000

### Health Check
{{baseUrl}}/health

### Register
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email":"test2@test.com",
  "username":"test2-user",
  "password":"test1234"
}

### Verify-email
POST {{baseUrl}}/api/auth/verify-email?token=1528aec3-8a2a-42c2-8c8c-becfa6adfeae


### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email":"test2@test.com",
  "password":"test1234"
}

### Refresh
POST {{baseUrl}}/api/auth/refresh

### Forgot-password
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email":"test@test.com"
}

### Reset-password
POST {{baseUrl}}/api/auth/reset-password?token=d3bfb63c-d4e8-476a-850d-68afd1e4e6c3
Content-Type: application/json

{
 "password":"test-password"
}

### Logout
POST {{baseUrl}}/api/auth/logout

### Logout-all
POST {{baseUrl}}/api/auth/logout-all

### Create category
