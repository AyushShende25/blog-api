{
	"compilerOptions": {
		"module": "esnext",
		"target": "es2024",
		"moduleResolution": "bundler",

		"types": ["node"],

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,

		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@modules/*": ["src/modules/*"]
		},
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["src", "prisma.config.ts"]
}
