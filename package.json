{
	"name": "blog-api",
	"version": "1.0.0",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"dev": "tsup --watch --onSuccess \"node --env-file=.env dist/server.js\"",
		"dev:worker": "tsup --watch --onSuccess \"node --env-file=.env dist/worker.js\"",
		"start": "node --env-file=.env dist/server.js",
		"start:worker": "node --env-file=.env dist/worker.js",
		"build": "tsup",
		"clean": "rm -rf dist",
		"format": "npx @biomejs/biome format --write",
		"lint": "npx @biomejs/biome lint --write",
		"check": "npx @biomejs/biome check --write",
		"db:generate": "npx prisma generate",
		"db:migrate": "npx prisma migrate deploy",
		"db:deploy": "npm run db:migrate && npm run db:generate",
		"prepare": "husky || true"
	},
	"author": "Ayush",
	"license": "MIT",
	"engines": {
		"node": ">=24.15.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.966.0",
		"@aws-sdk/s3-request-presigner": "^3.966.0",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^5.66.4",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"express-rate-limit": "^8.2.1",
		"helmet": "^8.1.0",
		"hpp": "^0.2.3",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"nodemailer": "^7.0.12",
		"pg": "^8.16.3",
		"redis": "^5.10.0",
		"sanitize-html": "^2.17.0",
		"slugify": "^1.6.6",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/hpp": "^0.2.7",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^25.0.5",
		"@types/nodemailer": "^7.0.4",
		"@types/pg": "^8.16.0",
		"@types/sanitize-html": "^2.16.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prisma": "^7.2.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3"
	}
}
